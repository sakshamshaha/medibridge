// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          String         @default("CUSTOMER")
  prescriptions Prescription[]
  retailerStock RetailerStock[] // If user is RETAILER
  bills         Bill[]          // If user is RETAILER
  demandNodes   DemandNodeItem[]// If user is RETAILER
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Hospital {
  id                 String              @id @default(uuid())
  externalId         String?
  name               String
  type               String              // e.g. private, govt
  address            String              @default("")
  city               String              @default("")
  latitude           Float?
  longitude          Float?
  phone              String?
  specialties        String?             // Store as JSON array string or comma-separated
  licenses           String?
  patientsTreated    String?             // e.g. "250+"
  photos             String?             // URLs to S3
  website            String?
  beds               Int?
  notes              String?
  empanelment        String?
  verificationSource String?
  procedures         Procedure[]
  doctors            DoctorHospital[]
  insurance          InsuranceProvider[]
  
  // Google Places API integration
  placeId                String?
  googleRating           Float?
  googleUserRatingsTotal Int?
  googleReviews          String?             // JSON array string
  googlePhotos           String?             // JSON array string
  googleFormattedAddress String?
  lastSyncedAt           DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([externalId, city])
}

model Procedure {
  id               String    @id @default(uuid())
  name             String    // e.g., PCNL, URS, RIRS
  diseaseTags      String
  expenseBreakdown String      // Store room tiers, itemized consumables as JSON
  hospitalId       String
  hospital         Hospital  @relation(fields: [hospitalId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Doctor {
  id               String            @id @default(uuid())
  externalId       String?           @unique
  name             String
  photo            String?
  qualifications   String
  experienceYears  Int
  hospitals        DoctorHospital[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model DoctorHospital {
  doctorId   String
  hospitalId String
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@id([doctorId, hospitalId])
}

model InsuranceProvider {
  id           String   @id @default(uuid())
  providerName String
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
}

model Medicine {
  id                  String             @id @default(uuid())
  externalId          String?            @unique
  name                String
  genericName         String?
  strength            String?
  dosageForm          String?
  manufacturer        String?
  category            String?
  therapeuticClass    String?
  packSize            String?
  requiresPrescription Boolean           @default(false)
  mrp                 Float?
  sellingPrice        Float?
  discount            Float?
  uses                String?
  description         String?
  imageFilename       String?
  imageSource         String?
  sourceUrl           String?
  catalogStatus       String?
  lastUpdatedDate     DateTime?
  isDemoData          Boolean            @default(false)
  
  scheduleClass       String?
  stocks              RetailerStock[]
  demandNodeItems     DemandNodeItem[]
  billItems           BillItem[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model RetailerStock {
  id             String    @id @default(uuid())
  medicineId     String
  retailerId     String
  qty            Int       @default(0)
  expiryDate     DateTime?
  avgDailySales  Float     @default(0)
  medicine       Medicine  @relation(fields: [medicineId], references: [id])
  retailer       User      @relation(fields: [retailerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Bill {
  id                     String      @id @default(uuid())
  retailerId             String
  retailer               User        @relation(fields: [retailerId], references: [id])
  items                  BillItem[]
  prescribingDoctorName  String?     // required if restricted medicines are in items
  total                  Float
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model BillItem {
  id         String   @id @default(uuid())
  billId     String
  medicineId String
  qty        Int
  price      Float
  bill       Bill     @relation(fields: [billId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
}

model DemandNodeItem {
  id         String   @id @default(uuid())
  retailerId String
  medicineId String
  checked    Boolean  @default(false)
  retailer   User     @relation(fields: [retailerId], references: [id])
  medicine   Medicine @relation(fields: [medicineId], references: [id])
}

model Prescription {
  id         String   @id @default(uuid())
  customerId String
  imageUrl   String
  ocrResult  String?
  status     String   // e.g., PENDING, VERIFIED, REJECTED
  customer   User     @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
